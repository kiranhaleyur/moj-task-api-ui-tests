{
  "name": "moj-task-api-ui-tests",
  "version": "1.0.0",
  "description": "Playwright API and UI tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean:reports": "rimraf allure-results allure-report test-results playwright-report",
    "pretest": "npm run clean:reports",
    "test": "playwright test",
    "test:ui": "npm run clean:reports && playwright test --project=ui-tests",
    "test:ui:firefox": "npm run clean:reports && CROSS_BROWSER=1 playwright test --project=ui-firefox",
    "test:ui:edge": "npm run clean:reports && CROSS_BROWSER=1 playwright test --project=ui-edge",
    "test:api": "npm run clean:reports && playwright test --project=api-tests",
    "test:smoke": "npm run clean:reports && playwright test --grep @smoke",
    "test:regression": "npm run clean:reports && playwright test --grep @regression",
    "test:headed": "npm run clean:reports && playwright test --headed",
    "test:debug": "npm run clean:reports && playwright test --debug",
    "allure:serve": "allure serve allure-results",
    "codegen": "playwright codegen",
    "build": "tsc",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write .",
    "lint:fix": "eslint '**/*.ts' --fix"
  },
  "keywords": [
    "playwright",
    "api",
    "ui",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
